# Airbyte API configuration
# For self-managed (abctl localhost): http://localhost:8000/api/public/v1
# For Airbyte Cloud: https://api.airbyte.com/v1
AIRBYTE_API_URL=http://localhost:8000/api/public/v1

# Get these from: abctl local credentials (self-managed)
# Or from: Airbyte UI > User Settings > Applications (Cloud)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Optional: skip token exchange by providing a pre-fetched token
# AIRBYTE_ACCESS_TOKEN=

# HTTP transport settings (only used by airbyte-mcp-http)
# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080

# Optional: live/destructive pytest settings (see tests/conftest.py)
# AIRBYTE_TEST_CONNECTION_ID=
# AIRBYTE_TEST_STREAM_NAME=
# AIRBYTE_TEST_ALLOW_DESTRUCTIVE=1
